<Window x:Class="Luma.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Luma">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Loaded="OnLoaded">
  <Grid.KeyboardAccelerators>
   <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopyShortcut"/><KeyboardAccelerator Key="X" Modifiers="Control" Invoked="CutShortcut"/><KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteShortcut"/><KeyboardAccelerator Key="A" Modifiers="Control" Invoked="SelectShortcut"/><KeyboardAccelerator Key="Delete" Invoked="DeleteShortcut"/><KeyboardAccelerator Key="F2" Invoked="RenameShortcut"/>
  </Grid.KeyboardAccelerators>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Padding="16,24,16,16" Spacing="12">
     <TextBlock Text="Luma" FontSize="30" FontWeight="SemiBold" Margin="8,0,0,8"/>
     <ListView x:Name="Navigation" SelectionChanged="NavigationChanged" SelectedIndex="0"><x:String>Library</x:String><x:String>Timeline</x:String><x:String>Photos</x:String><x:String>Videos</x:String><x:String>Favorites</x:String></ListView>
     <TextBlock Text="ALBUMS" FontSize="11" Opacity="0.55" Margin="8,12,0,0"/>
     <ComboBox x:Name="AlbumsBox" PlaceholderText="Choose an album" HorizontalAlignment="Stretch" SelectionChanged="AlbumChanged" AutomationProperties.Name="Album filter" AllowDrop="True" DragOver="AlbumDragOver" Drop="AlbumDrop"/>
     <StackPanel Orientation="Horizontal" Spacing="6"><Button Content="+ Album" Click="NewAlbum"/><Button Content="⋯" AutomationProperties.Name="Album actions"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Rename album" Click="RenameAlbum"/><MenuFlyoutItem Text="Delete album" Click="DeleteAlbum"/><MenuFlyoutItem Text="Show all albums' media" Click="LeaveAlbum"/></MenuFlyout></Button.Flyout></Button></StackPanel>
     <TextBlock Text="DRIVES &amp; FOLDERS" FontSize="11" Opacity="0.55" Margin="8,12,0,0"/>
     <ComboBox x:Name="Sources" HorizontalAlignment="Stretch" SelectionChanged="FilterChanged" AutomationProperties.Name="Source filter"/>
     <TextBox x:Name="FolderFilter" PlaceholderText="Folder within source" TextChanged="SearchChanged" AutomationProperties.Name="Folder path"/>
     <Button Content="Up to parent folder" Click="ParentFolder" HorizontalAlignment="Stretch"/>
     <TextBlock x:Name="FolderHint" Text="Select a source to browse folders" FontSize="11" TextWrapping="Wrap" Opacity="0.6"/>
     <ListView x:Name="FolderList" MaxHeight="190" SelectionMode="Single" SelectionChanged="FolderSelected" AutomationProperties.Name="Cached folders" AllowDrop="True" DragOver="FolderDragOver" Drop="FolderDrop">
      <ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,3"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MediaCount}" FontSize="10" Opacity="0.55"/></StackPanel></DataTemplate></ListView.ItemTemplate>
     </ListView>
     <Button x:Name="AddSourceButton" Content="+ Add folder or drive" HorizontalAlignment="Stretch" Click="AddSource"/>
     <Expander x:Name="SourceTools" Header="Drive tools" HorizontalAlignment="Stretch">
      <StackPanel Spacing="8">
       <Button x:Name="RescanButton" Content="Rescan sources" Click="Rescan"/>
       <Button Content="Refresh metadata" Click="RefreshMetadata"/>
       <Button Content="Rename source label" Click="RenameSourceLabel"/>
       <Button Content="Remove selected source" Click="RemoveSource"/>
       <Button x:Name="PrepareButton" Content="Prepare offline previews" Click="PrepareOffline"/>
       <Button Content="Check offline coverage" Click="CheckCoverage"/>
       <TextBlock x:Name="CoverageText" Text="Check coverage before disconnecting." FontSize="11" TextWrapping="Wrap" MaxWidth="150"/>
       <Button Content="Clear thumbnail cache" Click="ClearCache"/>
      </StackPanel>
     </Expander>
     <Button Content="Settings" HorizontalAlignment="Stretch" Click="Settings"/>
    </StackPanel>
   </ScrollViewer>
  </Border>
  <Grid Grid.Column="1" Padding="24,24,24,14" RowSpacing="12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="Heading" Text="Library" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="LibrarySummary" Text="Your moments, together." FontSize="12" Opacity="0.6" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
    <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search your library" TextChanged="SearchChanged" VerticalAlignment="Center" AutomationProperties.Name="Search library"/>
   </Grid>
   <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
    <ComboBox x:Name="SortBox" SelectedIndex="4" SelectionChanged="FilterChanged" AutomationProperties.Name="Sort order" MinWidth="145"><x:String>Date modified</x:String><x:String>Oldest modified</x:String><x:String>Name</x:String><x:String>File size</x:String><x:String>Date taken</x:String><x:String>File type</x:String></ComboBox>
    <ToggleButton x:Name="DescendingButton" Content="↓" IsChecked="True" Checked="DirectionChanged" Unchecked="DirectionChanged" AutomationProperties.Name="Descending order"/>
    <Button Content="View" AutomationProperties.Name="Gallery view options"><Button.Flyout><Flyout><StackPanel Width="260" Spacing="10">
     <ComboBox x:Name="GroupBox" AutomationProperties.AutomationId="GroupBox" Header="Group by" SelectedIndex="2" SelectionChanged="GroupChanged"><x:String>None</x:String><x:String>Year</x:String><x:String>Month</x:String><x:String>Day</x:String></ComboBox>
     <Slider x:Name="ThumbnailSlider" AutomationProperties.AutomationId="ThumbnailSlider" Header="Thumbnail size" Minimum="120" Maximum="320" Value="190" StepFrequency="10" ValueChanged="ThumbnailSizeChanged"/>
     <CheckBox x:Name="NamesToggle" AutomationProperties.AutomationId="NamesToggle" Content="Show filenames" Checked="AppearanceChanged" Unchecked="AppearanceChanged"/><CheckBox x:Name="DetailsToggle" Content="Show dates and size" Checked="AppearanceChanged" Unchecked="AppearanceChanged"/><CheckBox x:Name="FitToggle" Content="Fit entire image" Checked="AppearanceChanged" Unchecked="AppearanceChanged"/><CheckBox x:Name="CompactToggle" Content="Compact spacing" Checked="AppearanceChanged" Unchecked="AppearanceChanged"/>
     <CheckBox x:Name="CommonToggle" Content="Everyday formats only" IsChecked="True" Checked="ContentFilterChanged" Unchecked="ContentFilterChanged"/><CheckBox x:Name="RecursiveToggle" Content="Include nested folders" IsChecked="True" Checked="ContentFilterChanged" Unchecked="ContentFilterChanged"/>
    </StackPanel></Flyout></Button.Flyout></Button>
    <ComboBox x:Name="DateJump" PlaceholderText="Jump to month" SelectionChanged="JumpDate" Width="145" AutomationProperties.Name="Jump to month"/>
    <Button Content="Reset" Click="ResetFilters"/><ToggleButton x:Name="InspectorToggle" AutomationProperties.AutomationId="InspectorToggle" Content="Details" Checked="InspectorChanged" Unchecked="InspectorChanged"/>
   </StackPanel>
   <InfoBar x:Name="Notice" Grid.Row="2" IsOpen="False" IsClosable="True"/>
   <Grid Grid.Row="3">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <GridView x:Name="MediaGrid" AutomationProperties.AutomationId="MediaGrid" SelectionMode="Extended" IsItemClickEnabled="False" DoubleTapped="GridDoubleTapped" SelectionChanged="SelectionChanged" RightTapped="GridRightTapped" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ContainerContentChanging="TileChanging" Loaded="GalleryLoaded" CanDragItems="True" DragItemsStarting="StartDrag" PointerWheelChanged="GalleryWheel">
     <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
     <GridView.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Key}" FontSize="22" FontWeight="SemiBold" Margin="5,20,0,10"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></GridView.GroupStyle>
     <GridView.ItemTemplate><DataTemplate>
      <StackPanel Width="{Binding TileWidth}" Margin="{Binding Spacing}" Spacing="5" Opacity="{Binding CutOpacity}" AutomationProperties.Name="{Binding Name}" ToolTipService.ToolTip="{Binding Name}">
       <Grid Height="{Binding TileHeight}" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6"><FontIcon Glyph="&#xEB9F;" Opacity="0.2" FontSize="28"/><Image Source="{Binding Thumbnail}" Stretch="{Binding Fit}"/><Border Background="#88000000" VerticalAlignment="Bottom" HorizontalAlignment="Left" CornerRadius="3" Padding="5,2"><TextBlock Text="{Binding State}" Foreground="White" FontSize="10"/></Border></Grid>
       <TextBlock Text="{Binding Name}" Visibility="{Binding Labels}" FontSize="12" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="{Binding Caption}" Visibility="{Binding Details}" FontSize="10" Opacity="0.6"/>
      </StackPanel>
     </DataTemplate></GridView.ItemTemplate>
     <GridView.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Open" Click="OpenSelected"/><MenuFlyoutItem Text="Show in Explorer" Click="RevealSelected"/><MenuFlyoutItem Text="Copy path" Click="CopyPath"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Copy" Click="CopySelected"/><MenuFlyoutItem Text="Cut" Click="CutSelected"/><MenuFlyoutItem Text="Paste into folder…" Click="PasteSelected"/><MenuFlyoutItem Text="Copy to folder…" Click="CopyToFolder"/><MenuFlyoutItem Text="Move to folder…" Click="MoveToFolder"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Add to album…" Click="AddToAlbum"/><MenuFlyoutItem Text="Remove from this album" Click="RemoveFromAlbum"/><MenuFlyoutItem Text="Select all matching results" Click="SelectAllMatching"/><MenuFlyoutItem Text="Rename…" Click="RenameSelected"/><MenuFlyoutItem Text="Delete to Recycle Bin…" Click="DeleteSelected"/></MenuFlyout></GridView.ContextFlyout>
    </GridView>
    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="340"><FontIcon Glyph="&#xEB9F;" FontSize="44" Opacity="0.3"/><TextBlock x:Name="EmptyTitle" Text="Your library starts here" FontSize="24" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyText" Text="Add a folder or drive. Your originals stay where they belong." TextWrapping="Wrap" TextAlignment="Center" Opacity="0.6"/></StackPanel>
    <Border x:Name="Inspector" Grid.Column="1" Width="230" Padding="16" Margin="12,0,0,0" Visibility="Collapsed" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8"><ScrollViewer><StackPanel Spacing="12"><TextBlock Text="File details" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SelectionText" Text="Select media to inspect" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBox x:Name="TagsBox" Header="Tags for selected files" PlaceholderText="Comma-separated tags" MaxLength="1000"/><Button Content="Save tags" Click="SaveTags"/><Button Content="Add to album…" Click="AddToAlbum"/></StackPanel></ScrollViewer></Border>
   </Grid>
   <StackPanel x:Name="SelectionBar" Grid.Row="4" Orientation="Horizontal" Spacing="8" Visibility="Collapsed"><TextBlock x:Name="SelectionCount" VerticalAlignment="Center"/><Button Content="Open" Click="OpenSelected"/><Button Content="Copy" Click="CopySelected"/><Button Content="Cut" Click="CutSelected"/><Button Content="Paste" Click="PasteSelected"/><Button x:Name="FavoriteButton" Content="☆ Favorite" Click="ToggleFavorite"/></StackPanel>
   <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="8"><ProgressRing x:Name="Busy" Width="16" Height="16" IsActive="False"/><TextBlock x:Name="Status" Text="Opening library…" Opacity="0.6" FontSize="11" VerticalAlignment="Center" MaxWidth="500" TextTrimming="CharacterEllipsis"/></StackPanel><Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Click="CancelScan" Visibility="Collapsed"/></Grid>
  </Grid>
 </Grid>
</Window>
