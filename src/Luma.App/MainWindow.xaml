<Window x:Class="Luma.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Luma">
 <Grid x:Name="Root" Background="{ThemeResource LumaCanvas}" Loaded="OnLoaded">
  <Grid.Resources>
   <ResourceDictionary>

    <Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12,8"/></Style>
    <Style TargetType="ToggleButton"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12,8"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="{ThemeResource LumaControl}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12,8"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="{ThemeResource LumaControl}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12,8"/></Style>
    <Style TargetType="ListViewItem"><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,2"/></Style>
   </ResourceDictionary>
  </Grid.Resources>
  <Grid.KeyboardAccelerators>
   <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopyShortcut"/><KeyboardAccelerator Key="X" Modifiers="Control" Invoked="CutShortcut"/><KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteShortcut"/><KeyboardAccelerator Key="A" Modifiers="Control" Invoked="SelectShortcut"/><KeyboardAccelerator Key="Delete" Invoked="DeleteShortcut"/><KeyboardAccelerator Key="F2" Invoked="RenameShortcut"/>
  </Grid.KeyboardAccelerators>
  <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{ThemeResource LumaSidebar}">
   <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Padding="18,28,18,20" Spacing="10">
     <StackPanel Margin="12,0,0,20" Spacing="3"><TextBlock Text="Luma" FontSize="26" FontWeight="SemiBold" CharacterSpacing="-30"/><TextBlock Text="A place for your moments" FontSize="11" Opacity="0.65"/></StackPanel>
     <ListView x:Name="Navigation" SelectionChanged="NavigationChanged" SelectedIndex="0"><x:String>Library</x:String><x:String>Photos</x:String><x:String>Videos</x:String><x:String>Favorites</x:String><x:String>On this day</x:String></ListView>
     <TextBlock Text="Albums" FontSize="12" FontWeight="SemiBold" Opacity="0.65" Margin="12,22,0,0"/>
     <ComboBox x:Name="AlbumsBox" PlaceholderText="Choose an album" HorizontalAlignment="Stretch" SelectionChanged="AlbumChanged" AutomationProperties.Name="Album filter" AllowDrop="True" DragOver="AlbumDragOver" Drop="AlbumDrop" ToolTipService.ToolTip="Browse a virtual album. Drag selected media here to add it." AutomationProperties.HelpText="Browse a virtual album. Drag selected media here to add it."/>
     <StackPanel Orientation="Horizontal" Spacing="6"><Button Content="+ Album" Click="NewAlbum" ToolTipService.ToolTip="Create a virtual album without moving or duplicating original files." AutomationProperties.HelpText="Create a virtual album without moving or duplicating original files."/><Button Content="⋯" AutomationProperties.Name="Album actions"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Rename album" Click="RenameAlbum" ToolTipService.ToolTip="Change the album label without renaming folders." AutomationProperties.HelpText="Change the album label without renaming folders."/><MenuFlyoutItem Text="Delete album" Click="DeleteAlbum" ToolTipService.ToolTip="Delete this virtual album only; its original files remain intact." AutomationProperties.HelpText="Delete this virtual album only; its original files remain intact."/><MenuFlyoutItem Text="Show all albums' media" Click="LeaveAlbum" ToolTipService.ToolTip="Clear the album filter." AutomationProperties.HelpText="Clear the album filter."/></MenuFlyout></Button.Flyout></Button></StackPanel>
     <TextBlock Text="Folders &amp; drives" FontSize="12" FontWeight="SemiBold" Opacity="0.65" Margin="12,22,0,0"/>
     <Button Content="Manage sources" Click="ManageSources" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" ToolTipService.ToolTip="Browse, rename, refresh or remove a registered source. Removal never deletes originals." AutomationProperties.HelpText="Browse, rename, refresh or remove a registered source. Removal never deletes originals."/>
     <ComboBox x:Name="Sources" HorizontalAlignment="Stretch" SelectionChanged="FilterChanged" AutomationProperties.Name="Source filter" ToolTipService.ToolTip="Filter by a registered drive or folder, including offline sources." AutomationProperties.HelpText="Filter by a registered drive or folder, including offline sources."/>
     <StackPanel x:Name="FolderNavigation" Spacing="8" Visibility="Collapsed">
     <TextBox x:Name="FolderFilter" PlaceholderText="Folder within source" TextChanged="SearchChanged" AutomationProperties.Name="Folder path" ToolTipService.ToolTip="Filter by a folder relative to the selected source." AutomationProperties.HelpText="Filter by a folder relative to the selected source."/>
     <Button Content="Up to parent folder" Click="ParentFolder" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Go up one folder using the saved catalog, even when the drive is offline." AutomationProperties.HelpText="Go up one folder using the saved catalog, even when the drive is offline."/>
     <TextBlock x:Name="FolderHint" Text="Select a source to browse folders" FontSize="11" TextWrapping="Wrap" Opacity="0.6"/>
     <ListView x:Name="FolderList" MaxHeight="190" SelectionMode="Single" SelectionChanged="FolderSelected" AutomationProperties.Name="Cached folders" AllowDrop="True" DragOver="FolderDragOver" Drop="FolderDrop">
      <ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,3"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MediaCount}" FontSize="10" Opacity="0.55"/></StackPanel></DataTemplate></ListView.ItemTemplate>
     </ListView>
     </StackPanel>
     <Button x:Name="AddSourceButton" Content="+ Add folder or drive" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,12,0,0" Click="AddSource" ToolTipService.ToolTip="Add an existing folder or drive. Originals stay where they are; known drives open from the saved catalog." AutomationProperties.HelpText="Add an existing folder or drive. Originals stay where they are; known drives open from the saved catalog."/>
    </StackPanel>
   </ScrollViewer>
   <StackPanel Grid.Row="1" Padding="18,8,18,12" Spacing="2">     <Button Content="Storage &amp; previews" Click="StorageSettings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" ToolTipService.ToolTip="Check offline coverage, repair or rebuild previews, and manage local cache space." AutomationProperties.HelpText="Check offline coverage, repair or rebuild previews, and manage local cache space."/>
     <Button Content="Settings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Settings" ToolTipService.ToolTip="Choose appearance, cache size, startup position and exclusions." AutomationProperties.HelpText="Choose appearance, cache size, startup position and exclusions."/>
   </StackPanel></Grid>
  </Border>
  <Grid Grid.Column="1" Padding="28,28,24,16" RowSpacing="16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="Heading" Text="Library" FontSize="32" FontWeight="SemiBold" CharacterSpacing="-30"/><TextBlock x:Name="LibrarySummary" Text="Your moments, together." FontSize="12" Opacity="0.6" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBox x:Name="SearchBox" Width="200" PlaceholderText="Search photos, folders, tags" TextChanged="SearchChanged" VerticalAlignment="Center" AutomationProperties.Name="Search library" ToolTipService.ToolTip="Search saved filenames, folders and tags without scanning your drive." AutomationProperties.HelpText="Search saved filenames, folders and tags without scanning your drive."/>
    <Button Content="Refresh" AutomationProperties.Name="Refresh library"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Refresh this source" Click="RefreshSelectedSource" ToolTipService.ToolTip="Discover changed files in the selected connected source. Resume a paused scan when available." AutomationProperties.HelpText="Discover changed files in the selected connected source. Resume a paused scan when available."/><MenuFlyoutItem Text="Refresh all connected sources" Click="RefreshAllSources" ToolTipService.ToolTip="Discover changed files across connected sources. Offline sources are kept." AutomationProperties.HelpText="Discover changed files across connected sources. Offline sources are kept."/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Update drive status only" Click="RefreshDriveStatus" ToolTipService.ToolTip="Check drive availability without scanning for new files or moving your view." AutomationProperties.HelpText="Check drive availability without scanning for new files or moving your view."/><MenuFlyoutItem Text="Manage exclusions…" Click="ManageExclusions" ToolTipService.ToolTip="Review folder, source and extension rules; restore hidden media here." AutomationProperties.HelpText="Review folder, source and extension rules; restore hidden media here."/></MenuFlyout></Button.Flyout></Button></StackPanel>
   </Grid>
   <Border Grid.Row="1" Background="{ThemeResource LumaControl}" CornerRadius="12" Padding="4" HorizontalAlignment="Left">
   <StackPanel Orientation="Horizontal" Spacing="4">
    <ComboBox x:Name="SortBox" SelectedIndex="4" SelectionChanged="FilterChanged" AutomationProperties.Name="Sort order" MinWidth="145" ToolTipService.ToolTip="Choose the ordering. Date taken falls back to date modified when unavailable." AutomationProperties.HelpText="Choose the ordering. Date taken falls back to date modified when unavailable."><x:String>Date modified</x:String><x:String>Oldest modified</x:String><x:String>Name</x:String><x:String>File size</x:String><x:String>Date taken</x:String><x:String>File type</x:String></ComboBox>
    <ToggleButton x:Name="DescendingButton" Content="↓" IsChecked="True" Checked="DirectionChanged" Unchecked="DirectionChanged" AutomationProperties.Name="Descending order"/>
    <Button Content="View" AutomationProperties.Name="Gallery view options"><Button.Flyout><Flyout><StackPanel Width="260" Spacing="10"><Button Content="Show timeline" Click="ShowTimeline"/>
     <ComboBox x:Name="GroupBox" AutomationProperties.AutomationId="GroupBox" Header="Group by" SelectedIndex="2" SelectionChanged="GroupChanged" ToolTipService.ToolTip="Group the current timeline by year, month or day." AutomationProperties.HelpText="Group the current timeline by year, month or day."><x:String>None</x:String><x:String>Year</x:String><x:String>Month</x:String><x:String>Day</x:String></ComboBox>
     <Slider x:Name="ThumbnailSlider" AutomationProperties.AutomationId="ThumbnailSlider" Header="Thumbnail size" Minimum="120" Maximum="320" Value="190" StepFrequency="10" ValueChanged="ThumbnailSizeChanged" ToolTipService.ToolTip="Change tile size. Ctrl+mouse wheel also resizes thumbnails." AutomationProperties.HelpText="Change tile size. Ctrl+mouse wheel also resizes thumbnails."/>
     <CheckBox x:Name="NamesToggle" AutomationProperties.AutomationId="NamesToggle" Content="Show filenames" Checked="AppearanceChanged" Unchecked="AppearanceChanged" ToolTipService.ToolTip="Show filenames beneath thumbnails." AutomationProperties.HelpText="Show filenames beneath thumbnails."/><CheckBox x:Name="DetailsToggle" Content="Show dates and size" Checked="AppearanceChanged" Unchecked="AppearanceChanged" ToolTipService.ToolTip="Show dates and file sizes beneath thumbnails." AutomationProperties.HelpText="Show dates and file sizes beneath thumbnails."/><CheckBox x:Name="FitToggle" Content="Fit entire image" Checked="AppearanceChanged" Unchecked="AppearanceChanged" ToolTipService.ToolTip="Show the entire image instead of cropping it to fill the tile." AutomationProperties.HelpText="Show the entire image instead of cropping it to fill the tile."/><CheckBox x:Name="CompactToggle" Content="Compact spacing" Checked="AppearanceChanged" Unchecked="AppearanceChanged" ToolTipService.ToolTip="Use less space between gallery tiles." AutomationProperties.HelpText="Use less space between gallery tiles."/>
     <CheckBox x:Name="CommonToggle" Content="Everyday formats only" IsChecked="False" Checked="ContentFilterChanged" Unchecked="ContentFilterChanged" ToolTipService.ToolTip="Limit browsing to everyday photo/video extensions. This does not exclude files from scans." AutomationProperties.HelpText="Limit browsing to everyday photo/video extensions. This does not exclude files from scans."/><CheckBox x:Name="RecursiveToggle" Content="Include nested folders" IsChecked="True" Checked="ContentFilterChanged" Unchecked="ContentFilterChanged" ToolTipService.ToolTip="Include media in subfolders of the current folder." AutomationProperties.HelpText="Include media in subfolders of the current folder."/>
    </StackPanel></Flyout></Button.Flyout></Button>
    <Button Content="Months" Click="ShowTimeline" ToolTipService.ToolTip="Browse your timeline by month"/><ToggleButton x:Name="SelectMode" Content="Select" Checked="SelectModeChanged" Unchecked="SelectModeChanged" ToolTipService.ToolTip="Select several files with simple clicks"/>
    <Button Content="Reset" Click="ResetFilters" ToolTipService.ToolTip="Clear browsing filters. Exclusions remain active; restore them in Manage exclusions."/><ToggleButton x:Name="InspectorToggle" AutomationProperties.AutomationId="InspectorToggle" Content="Details" ToolTipService.ToolTip="Show file details" Checked="InspectorChanged" Unchecked="InspectorChanged"/>
   </StackPanel>
   </Border>
   <StackPanel Grid.Row="2" Spacing="8">
    <StackPanel x:Name="ResumeNavigation" Orientation="Horizontal" Spacing="8" Visibility="Collapsed"><TextBlock Text="Resumed here" VerticalAlignment="Center" Opacity="0.6"/><Button Content="Earlier items" Click="EarlierItems" ToolTipService.ToolTip="Load the previous 120 items while keeping your current position. No drive scan is needed." AutomationProperties.HelpText="Load the previous 120 items while keeping your current position. No drive scan is needed."/><Button Content="Back to start" Click="BackToStart" ToolTipService.ToolTip="Go to the beginning of this same filtered view." AutomationProperties.HelpText="Go to the beginning of this same filtered view."/></StackPanel>
    <StackPanel x:Name="MonthBrowser" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
     <Button x:Name="AllMonthsButton" Content="All months" Click="ClearMonth" ToolTipService.ToolTip="Clear only the month filter; keep other browsing filters." AutomationProperties.HelpText="Clear only the month filter; keep other browsing filters."/>
     <Button x:Name="NewerMonthButton" Content="Newer" Click="NewerMonth" AutomationProperties.Name="Newer month" ToolTipService.ToolTip="Show the next newer month with matching media." AutomationProperties.HelpText="Show the next newer month with matching media."/>
     <ComboBox x:Name="DateJump" PlaceholderText="Choose a month" SelectionChanged="JumpDate" Width="240" AutomationProperties.Name="Browse month" ToolTipService.ToolTip="Date taken when available; otherwise date modified. Counts follow your current filters."/>
     <Button x:Name="OlderMonthButton" Content="Older" Click="OlderMonth" AutomationProperties.Name="Older month" ToolTipService.ToolTip="Show the next older month with matching media." AutomationProperties.HelpText="Show the next older month with matching media."/>
    </StackPanel>
    <TextBlock x:Name="SelectionHint" Text="Click to select files · Ctrl+A selects loaded files" Visibility="Collapsed" FontSize="12" Opacity="0.65"/>
<ScrollViewer x:Name="FilterBar" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="ActiveFilters" Orientation="Horizontal" Spacing="4"/></ScrollViewer><CalendarDatePicker x:Name="MemoryDate" Visibility="Collapsed" DateChanged="MemoryDateChanged" AutomationProperties.Name="Memory day" PlaceholderText="Choose a day" ToolTipService.ToolTip="Find recorded capture dates from this day in previous years." AutomationProperties.HelpText="Find recorded capture dates from this day in previous years."/><InfoBar AutomationProperties.LiveSetting="Polite" x:Name="Notice" IsOpen="False" IsClosable="True"/></StackPanel>
   <Grid Grid.Row="3">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <GridView x:Name="MediaGrid" AutomationProperties.AutomationId="MediaGrid" SelectionMode="Extended" IsItemClickEnabled="False" DoubleTapped="GridDoubleTapped" SelectionChanged="SelectionChanged" RightTapped="GridRightTapped" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ContainerContentChanging="TileChanging" Loaded="GalleryLoaded" CanDragItems="True" DragItemsStarting="StartDrag" PointerWheelChanged="GalleryWheel">
     <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
     <GridView.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Key}" FontSize="21" FontWeight="SemiBold" CharacterSpacing="-15" Margin="5,24,0,14"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></GridView.GroupStyle>
     <GridView.ItemTemplate><DataTemplate>
      <StackPanel Width="{Binding TileWidth}" Margin="{Binding Spacing}" Spacing="5" Opacity="{Binding CutOpacity}" AutomationProperties.Name="{Binding Name}" ToolTipService.ToolTip="{Binding Name}">
       <Grid Height="{Binding TileHeight}" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10"><FontIcon Glyph="&#xEB9F;" Visibility="{Binding PlaceholderVisibility}" Opacity="0.2" FontSize="28"/><Image Source="{Binding Thumbnail}" Stretch="{Binding Fit}"/><Border Visibility="{Binding StatusVisibility}" Background="#88000000" VerticalAlignment="Bottom" HorizontalAlignment="Left" CornerRadius="5" Padding="6,3" Margin="6"><TextBlock Text="{Binding State}" Foreground="White" FontSize="10"/></Border></Grid>
       <TextBlock Text="{Binding Name}" Visibility="{Binding Labels}" FontSize="12" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="{Binding Caption}" Visibility="{Binding Details}" FontSize="10" Opacity="0.6"/>
      </StackPanel>
     </DataTemplate></GridView.ItemTemplate>
     <GridView.ContextFlyout><MenuFlyout Closed="ExclusionMenuClosed"><MenuFlyoutItem Text="Open" Click="OpenSelected" ToolTipService.ToolTip="Open this original in your default Windows application. Requires the source to be connected." AutomationProperties.HelpText="Open this original in your default Windows application. Requires the source to be connected."/><MenuFlyoutItem Text="Show in Explorer" Click="RevealSelected" ToolTipService.ToolTip="Reveal this original in Windows Explorer." AutomationProperties.HelpText="Reveal this original in Windows Explorer."/><MenuFlyoutItem Text="Copy path" Click="CopyPath" ToolTipService.ToolTip="Copy full paths of selected originals as text." AutomationProperties.HelpText="Copy full paths of selected originals as text."/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Exclude this folder…" Click="ExcludeFolder" ToolTipService.ToolTip="Hide this folder and its subfolders from this source and future scans. Originals are retained." AutomationProperties.HelpText="Hide this folder and its subfolders from this source and future scans. Originals are retained."/><MenuFlyoutItem Text="Exclude this source…" Click="ExcludeSource" ToolTipService.ToolTip="Hide this whole registered source and skip future scans until restored." AutomationProperties.HelpText="Hide this whole registered source and skip future scans until restored."/><MenuFlyoutItem Text="Exclude this file type…" Click="ExcludeType" ToolTipService.ToolTip="Hide this extension across all sources and skip it during scanning." AutomationProperties.HelpText="Hide this extension across all sources and skip it during scanning."/><MenuFlyoutItem Text="Manage exclusions…" Click="ManageExclusions" ToolTipService.ToolTip="Review folder, source and extension rules; restore hidden media here." AutomationProperties.HelpText="Review folder, source and extension rules; restore hidden media here."/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Copy" Click="CopySelected" ToolTipService.ToolTip="Copy selected original files to the Windows clipboard (Ctrl+C). Reconnect offline sources first." AutomationProperties.HelpText="Copy selected original files to the Windows clipboard (Ctrl+C). Reconnect offline sources first."/><MenuFlyoutItem Text="Cut" Click="CutSelected" ToolTipService.ToolTip="Prepare selected originals for moving (Ctrl+X). Files move only when pasted." AutomationProperties.HelpText="Prepare selected originals for moving (Ctrl+X). Files move only when pasted."/><MenuFlyoutItem Text="Paste into folder…" Click="PasteSelected" ToolTipService.ToolTip="Choose a destination and paste copied or cut originals (Ctrl+V). Existing filenames are skipped." AutomationProperties.HelpText="Choose a destination and paste copied or cut originals (Ctrl+V). Existing filenames are skipped."/><MenuFlyoutItem Text="Copy to folder…" Click="CopyToFolder" ToolTipService.ToolTip="Copy selected originals into another folder; leave originals in place." AutomationProperties.HelpText="Copy selected originals into another folder; leave originals in place."/><MenuFlyoutItem Text="Move to folder…" Click="MoveToFolder" ToolTipService.ToolTip="Move selected originals into another folder. Review the operation result for skipped files." AutomationProperties.HelpText="Move selected originals into another folder. Review the operation result for skipped files."/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Add to album…" Click="AddToAlbum" ToolTipService.ToolTip="Add selected media to a virtual album without moving originals." AutomationProperties.HelpText="Add selected media to a virtual album without moving originals."/><MenuFlyoutItem Text="Remove from this album" Click="RemoveFromAlbum" ToolTipService.ToolTip="Remove membership from this album; keep originals, tags and favorites." AutomationProperties.HelpText="Remove membership from this album; keep originals, tags and favorites."/><MenuFlyoutItem Text="Select all matching results" Click="SelectAllMatching" ToolTipService.ToolTip="Select every result in this filtered view, including unloaded items. Large selections use more memory." AutomationProperties.HelpText="Select every result in this filtered view, including unloaded items. Large selections use more memory."/><MenuFlyoutItem Text="Rename…" Click="RenameSelected" ToolTipService.ToolTip="Rename the selected original file (F2). Its extension must be retained." AutomationProperties.HelpText="Rename the selected original file (F2). Its extension must be retained."/><MenuFlyoutItem Text="Delete to Recycle Bin…" Click="DeleteSelected" ToolTipService.ToolTip="Ask Windows to delete selected originals. Review the Recycle Bin confirmation carefully." AutomationProperties.HelpText="Ask Windows to delete selected originals. Review the Recycle Bin confirmation carefully."/></MenuFlyout></GridView.ContextFlyout>
    </GridView>
    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="340"><FontIcon Glyph="&#xEB9F;" FontSize="44" Opacity="0.3"/><TextBlock x:Name="EmptyTitle" Text="Your moments belong here" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyText" Text="Add a folder or drive. Your originals stay where they belong." TextWrapping="Wrap" TextAlignment="Center" Opacity="0.6"/></StackPanel>
    <Border x:Name="Inspector" Grid.Column="1" Width="230" Padding="16" Margin="12,0,0,0" Visibility="Collapsed" Background="{ThemeResource LumaSidebar}" CornerRadius="14"><ScrollViewer><StackPanel Spacing="12"><TextBlock Text="File details" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SelectionText" Text="Select media to inspect" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBox x:Name="TagsBox" Header="Tags for selected files" PlaceholderText="Comma-separated tags" MaxLength="1000" ToolTipService.ToolTip="Enter comma-separated tags. Saving replaces tags for the selected files." AutomationProperties.HelpText="Enter comma-separated tags. Saving replaces tags for the selected files."/><Button Content="Save tags" Click="SaveTags" ToolTipService.ToolTip="Save these tags for selected files. Multiple selections replace their existing tags after confirmation." AutomationProperties.HelpText="Save these tags for selected files. Multiple selections replace their existing tags after confirmation."/><Button Content="Add to album…" Click="AddToAlbum" ToolTipService.ToolTip="Add selected media to a virtual album without moving originals." AutomationProperties.HelpText="Add selected media to a virtual album without moving originals."/></StackPanel></ScrollViewer></Border>
   </Grid>
   <Border x:Name="SelectionBar" Grid.Row="4" Background="{ThemeResource LumaControl}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" Visibility="Collapsed"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock x:Name="SelectionCount" VerticalAlignment="Center"/><Button Content="Copy to…" Click="CopyToFolder" ToolTipService.ToolTip="Copy selected originals into a folder"/><Button Content="Copy" Click="CopySelected" ToolTipService.ToolTip="Copy selected original files to the Windows clipboard (Ctrl+C). Reconnect offline sources first." AutomationProperties.HelpText="Copy selected original files to the Windows clipboard (Ctrl+C). Reconnect offline sources first."/><Button Content="Cut" Click="CutSelected" ToolTipService.ToolTip="Prepare selected originals for moving (Ctrl+X). Files move only when pasted." AutomationProperties.HelpText="Prepare selected originals for moving (Ctrl+X). Files move only when pasted."/><Button Content="More" AutomationProperties.Name="Selection actions"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Move to folder…" Click="MoveToFolder" ToolTipService.ToolTip="Move selected originals into another folder. Review the operation result for skipped files." AutomationProperties.HelpText="Move selected originals into another folder. Review the operation result for skipped files."/><MenuFlyoutItem Text="Add to album…" Click="AddToAlbum" ToolTipService.ToolTip="Add selected media to a virtual album without moving originals." AutomationProperties.HelpText="Add selected media to a virtual album without moving originals."/><MenuFlyoutItem Text="Copy paths" Click="CopyPath" ToolTipService.ToolTip="Copy full paths of selected originals as text." AutomationProperties.HelpText="Copy full paths of selected originals as text."/><MenuFlyoutItem Text="Select loaded files" Click="SelectLoaded" ToolTipService.ToolTip="Select only the items already loaded in the gallery." AutomationProperties.HelpText="Select only the items already loaded in the gallery."/><MenuFlyoutItem Text="Select all matching results" Click="SelectAllMatching" ToolTipService.ToolTip="Select every result in this filtered view, including unloaded items. Large selections use more memory." AutomationProperties.HelpText="Select every result in this filtered view, including unloaded items. Large selections use more memory."/><MenuFlyoutItem Text="Clear selection" Click="ClearSelection" ToolTipService.ToolTip="Deselect all files without changing filters." AutomationProperties.HelpText="Deselect all files without changing filters."/><MenuFlyoutItem Text="Paste into folder…" Click="PasteSelected" ToolTipService.ToolTip="Choose a destination and paste copied or cut originals (Ctrl+V). Existing filenames are skipped." AutomationProperties.HelpText="Choose a destination and paste copied or cut originals (Ctrl+V). Existing filenames are skipped."/></MenuFlyout></Button.Flyout></Button><Button x:Name="FavoriteButton" Content="☆ Favorite" Click="ToggleFavorite" ToolTipService.ToolTip="Add or remove favorites for all selected items." AutomationProperties.HelpText="Add or remove favorites for all selected items."/></StackPanel></Border>
   <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><ProgressBar x:Name="ImportProgress" AutomationProperties.AutomationId="ImportProgress" AutomationProperties.Name="Import phase progress" Height="3" Width="240" HorizontalAlignment="Left" Visibility="Collapsed"/><StackPanel Orientation="Horizontal" Spacing="8"><ProgressRing x:Name="Busy" Width="16" Height="16" IsActive="False"/><TextBlock x:Name="WorkElapsed" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/><TextBlock x:Name="Status" Text="Opening library…" Opacity="0.6" FontSize="11" VerticalAlignment="Center" MaxWidth="380" TextTrimming="CharacterEllipsis"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Activity" Click="ShowActivity" ToolTipService.ToolTip="See full progress, elapsed time, source and folder details, pause controls and recent results." AutomationProperties.HelpText="See full progress, elapsed time, source and folder details, pause controls and recent results."/><Button x:Name="CancelButton" Content="Pause" Click="CancelScan" Visibility="Collapsed" ToolTipService.ToolTip="Request a safe pause. Discovery keeps checkpoints; date reading keeps completed batches." AutomationProperties.HelpText="Request a safe pause. Discovery keeps checkpoints; date reading keeps completed batches."/></StackPanel></Grid>
  </Grid>
 </Grid>
</Window>
